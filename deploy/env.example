# Copy to /opt/cricbet/.env  (setup.sh does this for you)
# Permissions must be 600 and the file must never be committed or shared.

# Long random string used to sign login cookies.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# true once the site is served over HTTPS
SESSION_HTTPS_ONLY=true

# Your public address, used to build password-reset links (no trailing slash)
PUBLIC_BASE_URL=https://yourdomain.com
